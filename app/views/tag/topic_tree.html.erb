<style>
  .topic {
    background-color: #F5F5F5;
  }
  .icon {
    font-size: small;
  }
  .expand-btn {
    user-select: none;
  }
</style>

<script>
  $(document).ready(function() {
    $(document).on('click', '.expand-btn, a.list-group-item > i.icon', function(e) {
      e.preventDefault();
      e.stopPropagation();

      var $trigger = $(this);
      var $item = $trigger.closest('.topic-item');
      var topic = $trigger.data('topic');
      var $container;
      var $icon;

      if ($trigger.is('i.icon')) {
        $icon = $trigger;
      } else {
        $icon = $trigger.find('i.icon');
      }

      if ($item.length > 0) {
        $container = $item.children('.subtopics-container');
        if (!topic) {
          topic = $item.data('topic');
        }
      } else {
        var $a = $trigger.closest('a');
        if (!topic && $a.length > 0) {
          topic = $a.attr('href').replace(/^\//, '').replace(/^tag\//, '').trim();
        }
        $container = $a.next('.subtopics-container');
        if ($container.length === 0) {
          $container = $('<div class="subtopics-container list-group" style="display: none; margin-left: 20px;"></div>');
          $a.after($container);
        }
      }

      if (!topic) {
        return;
      }

      if ($container.data('loading')) {
        return;
      }

      if ($container.data('loaded')) {
        $container.slideToggle(200, function() {
          if ($container.is(':visible')) {
            $icon.removeClass('fa-chevron-right').addClass('fa-chevron-down');
          } else {
            $icon.removeClass('fa-chevron-down').addClass('fa-chevron-right');
          }
        });
        return;
      }

      $container.data('loading', true);
      $icon.removeClass('fa-chevron-right fa-chevron-down').addClass('fa-spinner fa-spin');

      $.ajax({
        url: '/tags/subtopics',
        data: { subtopic: topic },
        method: 'GET',
        dataType: 'html'
      }).done(function(response) {
        $container.html(response);
        $container.data('loaded', true);
        $container.data('loading', false);
        $container.slideDown(200);
        $icon.removeClass('fa-spinner fa-spin').addClass('fa-chevron-down');
      }).fail(function() {
        $container.data('loading', false);
        $icon.removeClass('fa-spinner fa-spin').addClass('fa-chevron-right');
        $container.html('<div class="list-group-item text-danger" style="font-style: italic;">&emsp;Failed to load subtopics.</div>');
        $container.slideDown(200);
      });
    });
  });
</script>
